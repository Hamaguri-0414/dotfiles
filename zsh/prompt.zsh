# =============================================================
# プロンプトの見た目設定（~/.zshrc から source されて読み込まれる）
# =============================================================
#
# --- よく使う記号のチートシート ---
#   %~        現在のフォルダ（ホームは ~ 表記。フルパスなら %/、直近だけなら %1~）
#   %n        ユーザー名
#   %m        ホスト名（MacBook-Pro とか。表示したければ %n@%m を足す）
#   %#        一般ユーザーなら「%」、root なら「#」
#   %*        現在時刻（HH:MM:SS）。日付なら %D
#   %F{色}〜%f  文字色を付ける（cyan, red, green, yellow, blue, magenta...）
#   %B〜%b     太字にする
#
# 変更したら `source ~/.zshrc` するか、新しいタブを開くと反映されます。

# -------------------------------------------------------------
# Git ブランチ表示の準備
# -------------------------------------------------------------
# zsh 標準の vcs_info を使って、今いるブランチ名を調べる。
# 調べた結果は ${vcs_info_msg_0_} という変数に入る。
autoload -Uz vcs_info

# git のときだけ有効にする（svn などは使わないので切っておく）
zstyle ':vcs_info:*' enable git

# 表示の書式。%b がブランチ名。
#   formats       … 通常時 →  ( main )
#   actionformats … rebase や merge の途中 →  ( main|REBASE )
zstyle ':vcs_info:git:*' formats       ' ( %b )'
zstyle ':vcs_info:git:*' actionformats ' ( %b|%a )'

# プロンプトを出す直前に毎回ブランチ名を調べ直す
precmd_vcs_info() { vcs_info }
precmd_functions+=( precmd_vcs_info )

# プロンプト内の ${...} を毎回展開させる（これが無いとブランチ名が更新されない）
setopt prompt_subst

# -------------------------------------------------------------
# 左プロンプト（メイン）
# -------------------------------------------------------------
# 1行目: シアン色で [ 現在のフォルダ ]、その右に緑色で ( ブランチ名 )
#         git 管理下でないフォルダでは ( ... ) の部分は何も出ない
# 2行目: 太字の % を表示（この後ろにコマンドを打つ）
# ※ ${vcs_info_msg_0_} を展開させたいので、ここは ' '（シングルクォート）で囲む
export PROMPT='%F{cyan} [ %~ ] %f%F{green}${vcs_info_msg_0_}%f
%B%#%b '

# 継続行のプロンプト（複数行のコマンドを入力中に出る「>」）
export PROMPT2=" %B>%b "

# 右プロンプト（右端に出るやつ）
# シアン色で [ 現在時刻 ] を表示
export RPROMPT="%F{cyan} [ %* ] %f"
