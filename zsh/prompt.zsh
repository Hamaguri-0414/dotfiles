# =============================================================
# プロンプトの見た目設定（~/.zshrc から source されて読み込まれる）
# =============================================================
#
# --- よく使う記号のチートシート ---
#   %~        現在のフォルダ（ホームは ~ 表記。フルパスなら %/、直近だけなら %1~）
#   %n        ユーザー名
#   %m        ホスト名（MacBook-Pro とか。表示したければ %n@%m を足す）
#   %#        一般ユーザーなら「%」、root なら「#」
#   %*        現在時刻（HH:MM:SS）。日付なら %D
#   %F{色}〜%f  文字色を付ける（cyan, red, green, yellow, blue, magenta...）
#   %B〜%b     太字にする
#
# 変更したら `source ~/.zshrc` するか、新しいタブを開くと反映されます。

# 左プロンプト（メイン）
# 1行目: シアン色で [ 現在のフォルダ ] を表示
# 2行目: 太字の % を表示（この後ろにコマンドを打つ）
export PROMPT="%F{cyan} [ %~ ] %f
%B%#%b "

# 継続行のプロンプト（複数行のコマンドを入力中に出る「>」）
export PROMPT2=" %B>%b "

# 右プロンプト（右端に出るやつ）
# シアン色で [ 現在時刻 ] を表示
export RPROMPT="%F{cyan} [ %* ] %f"
